# Your email address (display only — used to identify outbound emails in the log)
OUTLOOK_EMAIL=you@yourcompany.com

# Local path for the Excel tracker file (created automatically if missing)
EXCEL_FILE_PATH=./FundraisingTracker.xlsx

# Flask secret key
FLASK_SECRET_KEY=change-me-to-a-random-string

# Local AI model via Ollama (runs 100% on your machine — no data sent anywhere)
# Install: https://ollama.ai  then run: ollama pull llama3.2
# Alternatives: llama3.1:8b (smarter), mistral, qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# No IMAP server or password needed.
# Emails are read directly from the Outlook desktop app via macOS automation (JXA).
# Just make sure Outlook is open when you use the app.
