# Azure AD App Registration
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# Your Outlook email address
USER_EMAIL=you@yourcompany.com

# OneDrive/SharePoint Excel file path (relative to your OneDrive root)
# Example: /Documents/FundraisingTracker.xlsx
EXCEL_FILE_PATH=/Documents/FundraisingTracker.xlsx

# Optional: Flask secret key
FLASK_SECRET_KEY=change-me-to-a-random-string
