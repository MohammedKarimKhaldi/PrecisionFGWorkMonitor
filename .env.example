# Your Outlook / Microsoft email address
OUTLOOK_EMAIL=you@yourcompany.com

# Your password or app password
# Outlook.com personal: create an app password at https://account.microsoft.com/security
# Microsoft 365 work:   use your normal password (if basic-auth IMAP is enabled by your IT)
OUTLOOK_PASSWORD=your-password-or-app-password

# IMAP server — auto-detected from email domain, but you MUST set this for custom domains.
#
# GoDaddy Workspace Email (custom domain hosted by GoDaddy):
# IMAP_SERVER=imap.secureserver.net
#
# Microsoft 365 via GoDaddy (or any corporate M365):
# IMAP_SERVER=outlook.office365.com
#
# Outlook.com / Hotmail / Live (personal):  auto-detected, no override needed
# IMAP_SERVER=imap-mail.outlook.com

# Local path for the Excel tracker file (created automatically if missing)
EXCEL_FILE_PATH=./FundraisingTracker.xlsx

# Flask secret key
FLASK_SECRET_KEY=change-me-to-a-random-string
